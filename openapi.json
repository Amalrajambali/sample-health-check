{
  "openapi": "3.0.3",
  "info": {
    "title": "sample-health-check",
    "description": "A minimal Go HTTP service with a health check endpoint.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Service status",
        "description": "Plain-text message confirming the server is running.",
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "text/plain": {
                "schema": { "type": "string" },
                "example": "Server is running. Health check: /health | API docs: /swagger\n"
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns the service health, current time, uptime and version.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "timestamp", "uptime", "version"],
        "properties": {
          "status": { "type": "string", "example": "UP" },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-11-12T10:00:00Z" },
          "uptime": { "type": "string", "example": "42s" },
          "version": { "type": "string", "example": "1.0.0" }
        }
      }
    }
  }
}
